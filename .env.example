# Copy to .env for local runs; set these as environment variables in Dokploy. Never commit real values.
OPENCODE_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=glm-5.2

# Optional caps (defaults shown)
MAX_PDF_MB=5
MAX_PAGES=40
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=6
VISITOR_DAILY_CAP=5
GLOBAL_DAILY_CAP=100
USAGE_DB=usage.sqlite3

MAX_CHUNKS=500
MIN_SIMILARITY=0.10
# Header set by your reverse proxy with the real client IP (right-most entry is used)
TRUSTED_IP_HEADER=X-Forwarded-For
